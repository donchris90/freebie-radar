# Public (bundled into the app). Never put secrets here.
# Development only. Phone on the same Wi-Fi: http://<your-computer-LAN-IP>:3001  (port is whatever the API runs on)
# Release builds read EXPO_PUBLIC_API_URL from eas.json instead and must be https.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Ads (see docs/ADS.md). Off unless true. Without your own ids, Google's test ads are used (store builds refuse that).
# EXPO_PUBLIC_ADS_ENABLED=false
# ADMOB_ANDROID_APP_ID=
# ADMOB_IOS_APP_ID=
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# EXPO_PUBLIC_ADMOB_BANNER_IOS=
