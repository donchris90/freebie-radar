# Copy to .env — never commit real secrets.
NODE_ENV=development
PORT=3000
# STORE=prisma uses PostgreSQL (default in production). STORE=memory is for quick local trials only.
STORE=prisma
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/freebie_radar
REDIS_URL=redis://127.0.0.1:6381
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

# Launch market is configuration, not code.
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD
DEFAULT_DISTANCE_UNIT=mi
# Countries switched on the first time the app starts. Afterwards, enable or disable countries in the admin dashboard.
LAUNCH_COUNTRIES=US,CA,GB

# Providers: leave blank until you hold credentials/approval. Unconfigured providers return a setup state, never fake data.
PROVIDER_EXAMPLE_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# Payments: no provider enabled until country/currency/business eligibility is confirmed.
PAYMENT_PROVIDER=none

# Browser origins allowed to call the API (admin dashboard). Comma separated. Empty = none.
CORS_ORIGINS=http://localhost:5173

# Photo uploads. local = files on this machine (development). s3 = any S3-compatible bucket (production).
# STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# PUBLIC_BASE_URL=https://api.example.com   # required in production with local storage
# S3_BUCKET=  S3_REGION=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # where browsers and phones load photos from
# S3_ENDPOINT=   # only for R2 / MinIO

# --- Account safety -------------------------------------------------------------------------
# Email for verification and password-reset codes.
# Development: leave MAIL_DRIVER unset and the code is printed in the API console instead of emailed.
# Production: required. Example SMTP_URL: smtps://username:password@smtp.example.com:465
# MAIL_DRIVER=smtp
# SMTP_URL=
# MAIL_FROM="Freebie Radar <no-reply@yourdomain.com>"
# Only accounts with a verified email can post listings. Default: on in production, off otherwise.
# REQUIRE_VERIFIED_EMAIL=false
# Refresh tokens (how long a phone stays signed in without the password) and code resend gap.
# REFRESH_TTL_DAYS=30
# CODE_RESEND_SECONDS=60

# --- Scheduled jobs (BullMQ on Redis) --------------------------------------------------------
# With REDIS_URL set, listing expiry, alert dispatch, token cleanup and source sync run on their own.
# Without it (development only) they run when an admin presses the buttons. Production requires Redis.
# JOBS_ENABLED=true

# Partner listing feeds (see docs/LISTING_SOURCES.md). Off until an admin switches a source on.
# PARTNER_FEEDS=acme
# PARTNER_FEED_ACME_NAME=Acme Giveaways
# PARTNER_FEED_ACME_URL=https://api.acme.example/v1/listings
# PARTNER_FEED_ACME_API_KEY=
# PARTNER_FEED_ACME_COUNTRIES=US,GB
# PARTNER_FEED_ACME_ATTRIBUTION=Listings supplied by Acme Giveaways
# PARTNER_FEED_ACME_ATTRIBUTION_URL=https://acme.example
# PARTNER_FEED_ACME_PERMISSION_NOTE=Agreement signed 2026-09-30, ref FR-1
# PARTNER_FEED_ACME_EXPIRE_HOURS=48
# PARTNER_FEED_ACME_RETIRE_HOURS=72
# SYNC_INTERVAL_MINUTES=60

# In-app messaging abuse limits
# MSG_NEW_CONVERSATIONS_PER_DAY=10
# MSG_PER_HOUR=30
# MSG_MAX_UNANSWERED=5
# MSG_MAX_CHARS=1000

# Billing (see docs/BILLING.md). Flutterwave is the first provider.
# BILLING_PROVIDER=flutterwave
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_SECRET_HASH=
# PREMIUM_MONTHLY_PRICES=NGN:1500,USD:3.99
# FLUTTERWAVE_PREMIUM_MONTHLY_PLAN_IDS=NGN:12345,USD:12346
# BILLING_GRACE_DAYS=3
# BILLING_ALLOW_IOS=false
